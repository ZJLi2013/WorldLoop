+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Chunk-level reward from the T5 RoboTwin scorer.
+
+The scorer is supervised on chunk-final frames only, so scoring all 50 frames would ask
+it about timesteps it never saw a label for. Scoring the final frame and broadcasting
+also reproduces TOPRewardModel's output contract -- one binary label per env, repeated
+over the chunk -- which is what keeps the reward/termination rules a single variable
+against the F22b control arm.
+"""
+
+from typing import Optional
+
+import torch
+from omegaconf import DictConfig
+
+from rlinf.models.embodiment.reward.robotwin_reward_model import (
+    RoboTwinT5CrossAttnRewardModel,
+)
+
+
+class RoboTwinT5ChunkRewardModel(RoboTwinT5CrossAttnRewardModel):
+    """Score the chunk-final frame, binarize at the frozen threshold, broadcast."""
+
+    def __init__(self, cfg: DictConfig) -> None:
+        super().__init__(cfg)
+        self.chunk = int(cfg.chunk)
+        self.threshold = float(cfg.success_prob_threshold)
+        # Kept for the P4 dump: the gate needs the continuous score, not the 0/1 the env
+        # consumes, to draw a histogram and a confidence interval.
+        self.last_probs: Optional[torch.Tensor] = None
+
+    @torch.no_grad()
+    def predict_rew(
+        self,
+        obs: torch.Tensor,
+        instructions: Optional[list[str]] = None,
+    ) -> torch.Tensor:
+        num_envs = obs.shape[0] // self.chunk
+        if obs.min() < 0:
+            obs = (obs + 1.0) / 2.0
+        last_frames = obs.reshape(num_envs, self.chunk, *obs.shape[1:])[:, -1]
+        texts = (
+            None
+            if instructions is None
+            else [instructions[idx * self.chunk] for idx in range(num_envs)]
+        )
+        probs = self.compute_reward(last_frames, task_descriptions=texts)
+        self.last_probs = probs.detach()
+        return (probs >= self.threshold).float().repeat_interleave(self.chunk)
