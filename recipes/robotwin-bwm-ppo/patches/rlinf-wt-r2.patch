@@ -0,0 +1,60 @@
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from rlinf.envs.sim.world_model.world_model_env import WorldModelEnv
+
+
+class _StubEnv(WorldModelEnv):
+    def _build_backend(self, cfg):
+        raise NotImplementedError
+
+    def _load_reward_model(self, cfg):
+        raise NotImplementedError
+
+
+def make_env(ignore_terminations, elapsed_steps=0, max_episode_steps=100):
+    env = _StubEnv.__new__(_StubEnv)
+    env.num_envs = 2
+    env.chunk = 2
+    env.device = torch.device("cpu")
+    env.ignore_terminations = ignore_terminations
+    env.auto_reset = False
+    env.cfg = SimpleNamespace(max_episode_steps=max_episode_steps)
+    env._elapsed_steps = torch.full((2,), elapsed_steps, dtype=torch.long)
+    env.returns = torch.zeros(2)
+    env.success_once = torch.zeros(2, dtype=torch.bool)
+    env.onload = lambda: None
+    env._infer_next_chunk_frames = lambda actions: None
+    env._wrap_obs = lambda: {}
+    env._infer_next_chunk_rewards = lambda: torch.ones(2, 2)
+    env._calc_step_reward = lambda rewards: rewards
+    env._estimate_success_from_rewards = lambda rewards: torch.tensor([True, False])
+    return env
+
+
+@pytest.mark.parametrize("ignore_terminations", [False, True])
+def test_ignore_terminations_preserves_success_metrics(ignore_terminations):
+    env = make_env(ignore_terminations)
+
+    _, rewards, terminations, truncations, infos = env.chunk_step(
+        torch.zeros(2, 2, 1)
+    )
+
+    assert rewards.shape == (2, 2)
+    assert infos[0]["episode"]["success_once"].tolist() == [True, False]
+    assert terminations[:, -1].tolist() == [
+        not ignore_terminations,
+        False,
+    ]
+    assert not truncations.any()
+
+
+def test_ignore_terminations_keeps_time_limit():
+    env = make_env(True, elapsed_steps=2, max_episode_steps=4)
+
+    _, _, terminations, truncations, _ = env.chunk_step(torch.zeros(2, 2, 1))
+
+    assert not terminations.any()
+    assert truncations[:, -1].tolist() == [True, True]
