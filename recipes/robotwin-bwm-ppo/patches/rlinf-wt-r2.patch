index 0000000000000000000000000000000000000000..1629dda10f9b7129e4e1eac89d4194be89aaf640
--- /dev/null
+++ b/examples/embodiment/config/env/bwm_robotwin_adjust_bottle.yaml
@@ -0,0 +1,96 @@
+env_type: wan_wm
+task_suite_name: robotwin_adjust_bottle
+wm_env_type: robotwin
+
+total_num_envs: null
+
+auto_reset: False
+ignore_terminations: False
+max_steps_per_rollout_epoch: 200
+max_episode_steps: 200 # max episode steps for truncation
+
+use_rel_reward: True
+reward_coef: 1.0
+
+# RoboTwin's gripper resets closed at 1.0 rather than LIBERO's open at -1, and the
+# condition action turned out not to move BWM's output, so the window keeps its zeros.
+reset_gripper_open: False
+is_eval: False
+
+seed: 0
+group_size: 1
+use_fixed_reset_state_ids: True
+use_ordered_reset_state_ids: False
+specific_reset_id: null
+
+video_cfg:
+  save_video: True
+  info_on_video: True
+  video_base_dir: ${runner.logger.log_path}/video/train
+
+enable_offload: False
+
+###  ------------------ BWM params define here ------------------
+
+# RoboTwin writes a fresh paraphrase of the task per episode while BWM saw one phrasing per
+# task, so the two consumers of this string want different things. Off, BWM reads
+# world_model.remote.prompt instead and the pool is restricted to one task; that was measured
+# and did not change the picture, so the general setting stays on.
+wm_prompt_from_episode: True
+
+# BWM is served rather than loaded in-process: it needs python 3.12 and vllm-omni, while
+# the env worker runs RoboTwin's 3.11 stack.
+world_model:
+  backend: remote
+  remote:
+    transport: bwm_videos_sync
+    server_url: http://127.0.0.1:8010
+    model: /data/zhengjli/vomni/models/BWM
+    num_inference_steps: 50
+    fps: 24
+    request_timeout_s: 600
+    warmup_timeout_s: 1800
+    max_retries: 2
+    step_budget_s: 900
+    # BWM's own wording for this task, and the only one a four-chunk rollout has stayed
+    # coherent under (the init_frames_ep1 case). Every session shares it, so the pool has
+    # to stay on one task.
+    prompt: "Lift the narrow-necked bottle using the right arm and hold upright"
+
+# No KIR: the init-frame dataset holds one reset observation per episode, so the reference
+# frame fills the condition window on its own.
+enable_kir: False
+initial_image_path: /data/zhengjli/vomni/artifacts/init_frames/
+
+action_dim: 14
+state_dim: 14                # pi0 on RoboTwin reads two arms, not LIBERO's 16
+
+# The policy emits Aloha joint angles; BWM was trained on absolute end-effector poses
+# normalised against its demo percentiles. FK runs off the same URDF RoboTwin drives, and
+# the arm blocks come out in the opposite order from BWM's, hence the swap.
+action_bridge:
+  urdf_path: /data/zhengjli/vomni/RoboTwin/assets/embodiments/aloha-agilex/urdf/arx5_description_isaac.urdf
+  srdf_path: /data/zhengjli/vomni/RoboTwin/assets/embodiments/aloha-agilex/srdf/arx5_description_isaac.srdf
+  stat_path: /data/zhengjli/vomni/bwm-repo/demo/stat.json
+  robot_pose: [0.0, -0.65, 0.0, 0.707, 0.0, 0.0, 0.707]
+  swap_arm_blocks: true
+chunk: 50                    # same as num_action_chunks in pi0
+condition_frame_length: 9    # BWM's history window
+# BWM conditions on a stretch of video rather than anchoring on a reference image, so the
+# window rolls whole instead of pinning slot 0 to the reset frame.
+retain_reference_frame: False
+image_size: [480, 640]       # BWM's training resolution
+num_frames: 59               # condition_frame_length + chunk
+
+reward_model:
+  # The per-suite ResNet does not exist for RoboTwin, and the frozen VLM scored generated
+  # frames here at VOC 0.794 with the LIBERO threshold intact.
+  type: TOPRewardModel
+  from_pretrained: /data/zhengjli/rlinf/ckpt/qwen3-vl-8b-instruct
+  success_prob_threshold: 0.46
+  window_frames: 16
+  fps: 2.0
+  # Qwen3-VL needs transformers >= 4.57; openpi needs the 4.53.2 it patches in place.
+  # The scorer shadows sys.modules with this directory so both live in one launcher.
+  # Built by script/_setup_f2_venv.sh and shared with the LIBERO arm.
+  lib_dir: /data/zhengjli/rlinf/venvs/f2-vlm-libs
