+import os
+
+import pytest
+import torch
+from omegaconf import OmegaConf
+
+T5_PATH = os.environ.get("T5_MODEL_PATH")
+pytestmark = pytest.mark.skipif(not T5_PATH, reason="T5_MODEL_PATH not set")
+
+
+def build(model_path=None):
+    from rlinf.models.embodiment.reward.robotwin_reward_model import (
+        RoboTwinT5CrossAttnRewardModel,
+    )
+
+    cfg = OmegaConf.create(
+        {
+            "t5_model_name": T5_PATH,
+            "image_size": [3, 224, 224],
+            "pretrained_visual": False,
+            "model_path": model_path,
+        }
+    )
+    return RoboTwinT5CrossAttnRewardModel(cfg).eval()
+
+
+def test_forward_shapes_and_loss():
+    model = build()
+    images = torch.randint(0, 255, (2, 240, 320, 3), dtype=torch.uint8)
+    out = model(images, labels=torch.tensor([0, 1]), instructions=["left arm", "right arm"])
+    assert out["probabilities"].shape == (2,)
+    assert torch.isfinite(out["loss"])
+
+
+def test_strict_reload_matches(tmp_path):
+    model = build()
+    path = tmp_path / "reward.pt"
+    torch.save(model.state_dict(), path)
+    reloaded = build(str(path))
+    images = torch.randint(0, 255, (1, 224, 224, 3), dtype=torch.uint8)
+    a = model.compute_reward(images, ["lift the bottle"])
+    b = reloaded.compute_reward(images, ["lift the bottle"])
+    assert torch.allclose(a, b)
